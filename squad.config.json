  "worktreeDir": ".squad/worktrees",
  "dbFile": ".squad/squad.db",
  "planFile": ".squad/plan.json",
  "logDir": ".squad/logs",
  "maxParallel": 3,
  "timeoutMinutes": 30,
  "permissionMode": "restricted",
  "requireAcceptanceTest": false,
  "executionMode": "worktree",
  "maxReviewRounds": 2,
  "bootstrap": [],
