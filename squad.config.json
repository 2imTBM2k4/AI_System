      "cli": "9router",
      "model": "ag/gemini-3.8-flash-high",
      "command": [
        "node",
        "packages/core/bin/direct-runner.mjs",
        "--model",
        "{{model}}",
        "--prompt",
        "{{prompt}}"
      ],
      "env": {
        "ANTHROPIC_BASE_URL": "http://127.0.0.1:20128",
